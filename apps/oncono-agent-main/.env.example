# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ONCO_API: Base URL of the OnCo public oncology knowledge-graph JSON API
# (https://onco.cc/api/v1 by default). Data from OnCo (onco.cc), CC BY-NC 4.0.
# Point at a local build (e.g. ./out/api/v1) to run offline.
ONCO_API="https://onco.cc/api/v1"

# CIVIC_GRAPHQL: CIViC GraphQL endpoint (default https://civicdb.org/api/graphql). Public, no key.
CIVIC_GRAPHQL="https://civicdb.org/api/graphql"

# ONCOKB_TOKEN: OncoKB actionability annotations are token-gated. Unset -> /external/oncokb-annotate
# returns {available:false, configure:"ONCOKB_TOKEN"}. Register: https://www.oncokb.org/account/register
ONCOKB_TOKEN=""

# MATCHMINER_API: base URL of a MatchMiner instance (https://github.com/dfci/matchminer).
# Unset -> /external/matchminer returns {available:false, configure:"MATCHMINER_API"}.
MATCHMINER_API=""

# PCGR_API: base URL of a running PCGR/CPSR report service (nf-core/variantprioritization).
# Unset -> /external/pcgr returns {available:false, configure:"PCGR_API"}.
PCGR_API=""

# ── Genomic knowledge + drug/trial intelligence (all public, no key required) ──
# Layer 1 — Genomic knowledge

# ONCOTREE_API / ONCOTREE_VERSION: MSKCC OncoTree ontology. Replaces substring
# cancer-type matching with canonical codes. Fetched at boot, cached on disk for
# 24h under server/.cache/, with a bundled subset as offline fallback.
ONCOTREE_API="https://oncotree.mskcc.org/api"
ONCOTREE_VERSION="oncotree_latest_stable"

# ENSEMBL_REST: Ensembl REST base for VEP functional annotation + gnomAD frequencies.
# Note: rest.ensembl.org is genuinely flaky (observed 5xx/timeouts); calls are
# timeout-bounded and failures surface as {available:false, reason}.
ENSEMBL_REST="https://rest.ensembl.org"

# Layer 2 — Drug and trial intelligence

# OPEN_TARGETS_API: Open Targets Platform GraphQL v4 (alteration -> druggable
# target -> drugs, plus target safety liabilities and tractability).
OPEN_TARGETS_API="https://api.platform.opentargets.org/api/v4/graphql"

# CHEMBL_API: ChEMBL REST base (drug identity, mechanism, CYP metabolism, warnings).
# DrugBank is licensed and not used; ChEMBL carries the open equivalents.
CHEMBL_API="https://www.ebi.ac.uk/chembl/api/data"

# ClinicalTrials.gov API v2 needs no configuration; /onco-agent/trials/match
# queries it server-side and ranks results against the patient genomic profile.
