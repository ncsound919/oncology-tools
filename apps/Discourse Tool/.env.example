# ---------------------------------------------------------------------------
# Model access — the FLEET ROUTER is the default
# ---------------------------------------------------------------------------
# The ecosystem serves every model through one LiteLLM router with fallbacks
# and a budget guard. It already carries `gemini`, `deepseek`, `ollama-cloud`,
# `openrouter-free` and the opencode lanes, so a per-app provider key is the
# weaker setup: one provider, one key to rotate, no fallback.
#
#   launcher : orchestration/llm/start-litellm.cmd  (port 4100)
#   config   : INFRASTRUCTURE/model-router/litellm.yaml  (canonical)
#   watchdog : orchestration/router-watchdog.mjs  (restarts it if it dies)
#
# OPENAI_API_KEY is the router's master key (LITELLM_MASTER_KEY — resolve from
# Infisical; do not paste it here). OPENAI_MODEL is a router alias, not a vendor
# model id.
OPENAI_BASE_URL="http://127.0.0.1:4100"
OPENAI_API_KEY="<LITELLM_MASTER_KEY — see Infisical>"
OPENAI_MODEL="gemini"

# Which engine the server uses when a request does not name one.
#   openai  = the fleet router above (default)
#   gemini  = direct Google Gemini, needs GEMINI_API_KEY
#   llama   = a local Ollama instance
DISCOURSE_ENGINE="openai"

# ---------------------------------------------------------------------------
# Direct-provider fallback (only needed when DISCOURSE_ENGINE=gemini)
# ---------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"

APP_URL="MY_APP_URL"

# OLLAMA_URL: URL of your local Ollama instance (default: http://localhost:11434)
# If running in Cloud Run, this must be a publicly accessible URL (e.g. ngrok tunnel) pointing to your local machine.
# OLLAMA_URL="http://localhost:11434"

# OLLAMA_MODEL: The local Llama model to use (default: llama3.2)
# OLLAMA_MODEL="llama3.2"
